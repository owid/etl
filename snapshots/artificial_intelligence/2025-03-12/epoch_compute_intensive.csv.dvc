meta:
  origin:
    # Data product / Snapshot
    title: Data on AI Models
    title_snapshot: Large-scale AI models
    description: |-
      Epoch AI tracks over 3,700 machine learning models, from the 1950s to today. For each model, it records details such as the publication date, the developer, the number of parameters, the size of the training data, and the amount of computation used to train it.

      Epoch AI counts a model as large-scale if it was, or may have been, trained with more than 10²³ floating-point operations (FLOP). Some AI regulations use the same threshold.
    date_published: '2026-11-17'

    # Citation
    producer: Epoch AI
    citation_full: "Epoch AI, ‘Data on AI models’. Published online at epoch.ai. Retrieved from ‘https://epoch.ai/data/ai-models’ [online resource]"

    # Files
    url_main: https://epoch.ai/data/ai-models
    url_download: https://epoch.ai/data/epochdb/large_scale_ai_models.csv
    date_accessed: '2026-11-26'

